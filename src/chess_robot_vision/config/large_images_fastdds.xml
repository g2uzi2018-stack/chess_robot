<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>camera_local_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>camera_large_shm</transport_id>
      <type>SHM</type>
      <maxMessageSize>8388608</maxMessageSize>
      <segment_size>67108864</segment_size>
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="camera_large_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>camera_local_udp</transport_id>
        <transport_id>camera_large_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
