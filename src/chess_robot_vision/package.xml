<?xml version="1.0"?>
<package format="3">
  <name>chess_robot_vision</name>
  <version>0.1.0</version>
  <description>D405 synchronized rectified RGB-D acquisition, calibration and frame metadata.</description>
  <maintainer email="zzkuang0516@163.com">kuang</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 节点使用的 ROS 接口与图像转换。 -->
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>chess_robot_interface</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- 系统依赖使用 rosdep 键，与 CMake 中的查找名称不一定相同。 -->
  <depend>libopencv-dev</depend>
  <depend>librealsense2</depend>

  <!-- launch 文件直接使用的 Python 模块。 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- 仅供已保留的离线校正测试使用。 -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
